{
  "name": "sockerbagaren",
  "version": "1.0.0",
  "private": true,
  "description": "Sockerbagaren.se — företagsfika i södra Stockholm. Beställning, faktura och admin.",
  "scripts": {
    "dev": "next dev",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "prisma generate && next build",
    "build:demo": "prisma generate && tsx scripts/build-demo-db.ts && next build",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "admin:create": "tsx scripts/create-admin.ts",
    "subscriptions:generate": "tsx scripts/generate-subscription-orders.ts",
    "smoke": "tsx scripts/smoke.ts",
    "build:vercel": "node scripts/vercel-build.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@sentry/nextjs": "^10.72.0",
    "next": "^16.3.4",
    "pdfkit": "^0.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.3.4",
    "pdf-parse": "^1.1.1",
    "playwright-core": "^1.58.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
