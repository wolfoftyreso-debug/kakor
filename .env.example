# ============================================================
# Sockerbagaren.se — environment variables
# Kopiera till .env och fyll i. Värden markerade [EJ VERIFIERAT]
# är platshållare som MÅSTE bekräftas av verksamheten innan
# de visas på riktiga fakturor.
# ============================================================

# --- Databas ---
# SQLite-fil (lokal utveckling & enkel drift på server med disk).
DATABASE_URL="file:./dev.db"

# --- Sajt ---
# Publik bas-URL, används i e-postlänkar, sitemap och canonical.
SITE_URL="http://localhost:3000"

# --- Admin bootstrap ---
# Om ingen adminanvändare finns skapas en från dessa vid `npm run db:seed`
# (eller `npm run admin:create`). Ingen publik registrering finns.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="byt-mig-till-ett-langt-losenord"

# --- Sessioner ---
# Hemlighet för sessionskakor (minst 32 slumpmässiga tecken).
SESSION_SECRET="generera-en-lang-slumpmassig-strang"

# --- E-post ---
# EMAIL_PROVIDER: "resend" | "log"
#  - resend: skickar via Resend API (kräver RESEND_API_KEY)
#  - log:    skickar inget, loggar bara (utveckling/test)
EMAIL_PROVIDER="log"
RESEND_API_KEY=""
# Avsändaradress (domänen måste vara verifierad hos e-postleverantören).
EMAIL_FROM="Sockerbagaren <order@sockerbagaren.se>"

# --- Fakturauppgifter ---
# Juridiska uppgifter från designunderlaget (bekräftade av verksamheten):
INVOICE_COMPANY_NAME="Landvex AB"
INVOICE_ORG_NUMBER="559141-7042"
INVOICE_ADDRESS="Antennvägen 2"
INVOICE_POSTAL_CODE="135 48"
INVOICE_CITY="Tyresö"

# [EJ VERIFIERAT] — måste bekräftas innan skarpa fakturor skickas:
INVOICE_EMAIL="[EJ VERIFIERAT: faktura-e-post]"
INVOICE_PHONE="[EJ VERIFIERAT: telefonnummer]"
INVOICE_BANKGIRO="[EJ VERIFIERAT: bankgironummer]"
INVOICE_VAT_NUMBER="[EJ VERIFIERAT: momsregistreringsnummer, SE-format]"
INVOICE_F_SKATT="Godkänd för F-skatt"

# Betalningsvillkor i dagar (förfallodatum = fakturadatum + N dagar).
INVOICE_PAYMENT_TERMS_DAYS="30"

# --- Cron (valfritt) ---
# Hemlighet som krävs för att anropa POST /api/cron/generate-subscription-orders.
CRON_SECRET=""
