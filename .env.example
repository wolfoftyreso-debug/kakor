# ============================================================
# Sockerbagaren.se — environment variables
# Target-miljö: GitHub → Vercel → Neon PostgreSQL
#
# Kopiera till .env för lokal utveckling. Värden markerade
# [EJ VERIFIERAT] är platshållare som MÅSTE bekräftas av
# verksamheten innan de hamnar på riktiga fakturor.
#
# Miljöer (sätts i Vercel per environment):
#   Production  → production-Neon (poolad + direkt URL), riktiga värden
#   Preview     → SEPARAT Neon-databas/branch — ALDRIG production-DB
#   Development → lokal databas via `npm run dev:db` (eller egen Neon-dev)
# ============================================================

# --- Databas (Neon PostgreSQL) --- [SECRET]
# DATABASE_URL: Neons POOLADE anslutningssträng (värdnamn med "-pooler")
#   + "?sslmode=require&pgbouncer=true&connect_timeout=15"
#   Används av applikationen i runtime (serverless-säker pooling).
# DIRECT_DATABASE_URL: Neons DIREKTA (opoolade) anslutningssträng
#   + "?sslmode=require" — används ENDAST av prisma migrate.
# Lokal utveckling (npm run dev:db) använder värdena nedan:
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/sockerbagaren"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:55432/sockerbagaren"

# --- Sajt --- [ej hemlig]
# Publik bas-URL: används i e-postlänkar, sitemap, canonical och schema.
# Production: https://sockerbagaren.se — Preview: lämna tomt (härleds från
# Vercels deployment-URL).
SITE_URL="http://localhost:3000"

# --- Admin bootstrap --- [SECRET]
# Första admin skapas av `npm run db:seed` (endast om ingen admin finns)
# eller när som helst med `npm run admin:create`. Ingen publik registrering.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="byt-mig-till-ett-langt-losenord"

# --- E-post --- [RESEND_API_KEY är SECRET]
# EMAIL_PROVIDER: "resend" | "log". Riktiga utskick sker ENDAST i Vercel
# production — preview/dev loggar alltid (spärr i koden, kan inte mejla
# riktiga kunder av misstag).
EMAIL_PROVIDER="log"
RESEND_API_KEY=""
EMAIL_FROM="Sockerbagaren <order@sockerbagaren.se>"
# Svarsadress (bevakad låda) — kunder uppmanas "svara på det här mejlet".
EMAIL_REPLY_TO=""
# Intern avisering vid ny order (verksamhetens egen låda).
ADMIN_NOTIFY_EMAIL=""

# --- Fakturauppgifter --- [ej hemliga — hamnar på fakturan]
INVOICE_COMPANY_NAME="Landvex AB"
INVOICE_ORG_NUMBER="559141-7042"
INVOICE_ADDRESS="Antennvägen 2"
INVOICE_POSTAL_CODE="135 48"
INVOICE_CITY="Tyresö"
INVOICE_EMAIL="[EJ VERIFIERAT: faktura-e-post]"
INVOICE_PHONE="[EJ VERIFIERAT: telefonnummer]"
INVOICE_BANKGIRO="[EJ VERIFIERAT: bankgironummer]"
INVOICE_VAT_NUMBER="[EJ VERIFIERAT: momsregistreringsnummer, SE-format]"
INVOICE_F_SKATT="[EJ VERIFIERAT: F-skatt]"
INVOICE_PAYMENT_TERMS_DAYS="30"

# --- Cron --- [SECRET]
# Krävs för prenumerations-cronen (/api/cron/generate-subscription-orders).
# Vercel Cron skickar automatiskt "Authorization: Bearer <CRON_SECRET>"
# när variabeln finns i projektet. Schemat ligger i vercel.json.
CRON_SECRET=""

# --- Sök & mätning --- [ej hemliga, NEXT_PUBLIC_* inlinas i klienten]
# Preferred Sources-CTA: "true" ENDAST i production på riktiga domänen.
NEXT_PUBLIC_PREFERRED_SOURCES="false"
# GA4-mät-ID (t.ex. G-XXXXXXXXXX). Tomt = ingen analytics laddas alls.
# Satt = samtyckesbanner visas och Google-scriptet laddas först efter "Tillåt".
NEXT_PUBLIC_GA4_ID=""

# --- Robotskydd i kassan (Cloudflare Turnstile) ---
# Båda tomma = ingen widget, ingen verifiering. Skapa nycklar i Cloudflare
# (gratis) och sätt båda. Testnycklar som alltid passerar (bra i preview):
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Google Search Console-verifiering via meta-tagg: klistra in värdet ur
# GSC:s "HTML-tagg"-metod (content-attributet). Tomt = ingen tagg renderas.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# --- Felövervakning (Sentry) --- [DSN är publik identifierare, ej hemlig]
# Server-side felinsamling (klient-SDK medvetet bortvald — bundlevikt).
# Tom sträng stänger av. Default-DSN (Sentry-projektet landvex-ab/
# sockerbagaren, EU) ligger i src/lib/sentry-config.ts. Aktiv endast i
# deployade miljöer (Vercel) — aldrig i lokal utveckling eller tester.
SENTRY_DSN=""

