// Sockerbagaren — datamodell för Neon PostgreSQL.
// Statusfält är String med tillåtna värden i src/lib/status.ts (en enkel
// nivå av flexibilitet; värdena valideras alltid i applikationslagret).
// Alla belopp lagras i öre (Int) för att undvika flyttalsfel.
//
// Anslutningsstrategi (Vercel serverless + Neon):
//  - DATABASE_URL        = Neons POOLADE anslutningssträng (-pooler-värden)
//                          med ?pgbouncer=true&connect_timeout=15 — används
//                          av applikationen i runtime.
//  - DIRECT_DATABASE_URL = Neons direkta (opoolade) anslutningssträng —
//                          används ENDAST av migrations (prisma migrate).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  // Pris i öre per försäljningsenhet (per kilo för unit "kg", per paket för
  // unit "paket"). Historiska ordrar/fakturor påverkas ALDRIG av ändringar här
  // (snapshot sparas på orderrad och faktura).
  pricePerKgOre Int
  // Försäljningsenhet: "kg" (lösvikt per helt kilo) eller "paket" (styckvara,
  // t.ex. prova-på-paketet). Beloppsmatematiken är identisk: antal × á-pris.
  unit String @default("kg")
  // Informativ vikt per paket i gram (0 för lösviktsprodukter). Används för
  // sanna viktsummor i kassan/leveransvyn, aldrig för prisberäkning.
  packageWeightGrams Int @default(0)
  // Moms i baspunkter (livsmedel = 600 = 6 % t.o.m. 2027-12-31, därefter 1200).
  vatRateBp   Int      @default(600)
  // JSON-array med viktalternativ i kg, t.ex. [1,2,3].
  weightOptionsJson String @default("[1,2,3]")
  ingredients String   @default("")
  allergens   String   @default("")
  imageRef    String   @default("")
  // Kort etikett på produktkortet, t.ex. "Bästsäljare". Tom = ingen etikett.
  badge       String   @default("")
  // Ungefärligt antal kakor per kilo (uppmätt av verksamheten). null = visas inte.
  piecesPerKgApprox Int?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems        OrderItem[]
  subscriptionItems SubscriptionItem[]
  pollCandidates    PollCandidate[]
  inventory         Inventory?
  inventoryMovements InventoryMovement[]
}

model DeliveryArea {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  // JSON-array med ISO-veckodagar (1 = måndag ... 7 = söndag) då vi levererar hit.
  weekdaysJson String @default("[4]")
  // Antal hela dagar framförhållning som krävs (beställ senast N dagar före leverans).
  leadTimeDays Int    @default(2)
  // JSON-array med postnummerprefix (t.ex. ["135","136"]). Tom = ingen postnummerspärr.
  postalCodePrefixesJson String @default("[]")
  // JSON-array med ISO-datum då vi INTE levererar (semester, inventering).
  // Svenska helgdagar utesluts alltid automatiskt (dates.ts).
  blockedDatesJson String @default("[]")
  // Kapacitetstak i kilo per leveransdag (lösvikt + paketvikt). 0 = ingen gräns.
  // Fulla dagar döljs i kassan; prenumerationsordrar räknas in men stoppas aldrig.
  maxKgPerDay Int @default(0)
  active   Boolean @default(true)
  sortOrder Int    @default(0)

  orders        Order[]
  subscriptions Subscription[]
}

// Nummerserier (order- och fakturanummer). Uppräkning sker i transaktion.
// Kreditfaktura: en utfärdad faktura får aldrig bara "gömmas" när ordern
// avbryts — den krediteras med ett eget nummer i fakturaserien och ett eget
// dokument (negativa belopp) som mejlas till kunden.
model CreditNote {
  id           String  @id @default(cuid())
  creditNumber String  @unique // nästa nummer i fakturaserien
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id])

  // FULL = hela (återstående) fakturabeloppet, PARTIAL = valda rader/mängder.
  kind         String   @default("FULL")
  issuedDate   DateTime @default(now())
  snapshotJson String // krediterade rader + creditsInvoiceNumber, belopp negerade i PDF

  subtotalOre Int
  vatOre      Int
  totalOre    Int

  downloadToken String @unique
  createdAt     DateTime @default(now())

  @@index([invoiceId])
}

model Counter {
  name  String @id
  value Int
}

// Delad rate limit-räknare per nyckel (t.ex. "checkout:1.2.3.4",
// "admin-login:mail"). Fast fönster: count nollställs när resetAt passerats.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique // t.ex. SB-100001

  // Skydd mot dubbelbeställning: klienten genererar en nyckel per beställningsförsök.
  // Samma nyckel två gånger (dubbelklick/retry) returnerar samma order.
  idempotencyKey String? @unique

  // Kund/företag
  companyName String
  orgNumber   String
  contactName String
  email       String
  phone       String

  // Leverans
  deliveryAddress     String
  deliveryPostalCode  String
  deliveryCity        String
  deliveryInstruction String  @default("")
  deliveryDate        DateTime
  deliveryAreaId      String?
  deliveryArea        DeliveryArea? @relation(fields: [deliveryAreaId], references: [id])

  // Fakturering
  invoiceEmail   String
  reference      String @default("")
  billingAddress String @default("") // tom = samma som leveransadress

  // Belopp (öre) — snapshot vid ordertillfället
  subtotalOre Int
  vatOre      Int
  totalOre    Int
  currency    String @default("SEK")

  // Separata statusar — se src/lib/status.ts
  status         String @default("NEW")      // NEW | CONFIRMED | CANCELLED
  paymentStatus  String @default("UNPAID")   // UNPAID | PAID
  deliveryStatus String @default("PENDING")  // PENDING | DELIVERED
  // Operativ plockstatus (lager/leveransvecka). Oberoende av deliveryStatus.
  // UNPICKED | PICKED | LOADED | DELIVERED | PROBLEM
  pickStatus     String @default("UNPICKED")

  deliveredAt  DateTime?
  deliveryNote String    @default("")
  internalNote String    @default("")

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  // Idempotensnyckel för prenumerationsgenererade ordrar:
  // subscriptionId + periodens leveransdatum (ISO-datumsträng) får bara finnas en gång.
  subscriptionPeriod String?

  items               OrderItem[]
  invoice             Invoice?
  events              OrderEvent[]
  inventoryMovements  InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, subscriptionPeriod])
  @@index([deliveryDate])
  // Kapacitet per område och dag (bookedKgByDate) körs vid varje kassavisning.
  @@index([deliveryAreaId, deliveryDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([deliveryStatus])
  @@index([pickStatus])
  @@index([createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  // Snapshot — får inte ändras när produkten senare ändras.
  productName      String
  weightKg         Int // antal enheter (kilo för unit "kg", paket för unit "paket")
  unit             String @default("kg")
  // Paketvikt vid ordertillfället. Utan den här snapshoten räknas plock/lager
  // om när admin ändrar produktens paketvikt – historiska ordrar måste väga lika.
  packageWeightGrams Int @default(0)
  unitPricePerKgOre Int
  vatRateBp        Int
  lineTotalOre     Int // weightKg * unitPricePerKgOre

  // Postgres indexerar inte FK-kolumner automatiskt.
  @@index([orderId])
}

model Invoice {
  id            String @id @default(cuid())
  invoiceNumber String @unique // löpnummer i serie, t.ex. 10001
  orderId       String @unique
  order         Order  @relation(fields: [orderId], references: [id])

  invoiceDate DateTime @default(now())
  dueDate     DateTime

  // Ekonomisk + juridisk snapshot vid utfärdandet. Fakturan är ett historiskt
  // dokument: PDF och vyer renderas från denna JSON, aldrig från aktuell produkt-/kunddata.
  snapshotJson String

  subtotalOre Int
  vatOre      Int
  totalOre    Int
  currency    String @default("SEK")

  status String    @default("UNPAID") // UNPAID | PAID | CREDITED (OVERDUE beräknas från dueDate)
  paidAt DateTime?

  // Slumpad token för säker nedladdningslänk utan inloggning.
  downloadToken String @unique

  creditNotes CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
}

model Subscription {
  id     String @id @default(cuid())
  number String @unique // t.ex. PREN-1001

  // Dubbelklick/nätverksretry vid start får aldrig ge två prenumerationer.
  idempotencyKey String? @unique

  companyName String
  orgNumber   String
  contactName String
  email       String
  phone       String @default("")

  deliveryAddress     String
  deliveryPostalCode  String
  deliveryCity        String
  deliveryInstruction String @default("")
  deliveryAreaId      String?
  deliveryArea        DeliveryArea? @relation(fields: [deliveryAreaId], references: [id])

  invoiceEmail String
  reference    String @default("")
  /** Fakturaadress om annan än leveransadressen (tom = leveransadressen). */
  billingAddress String @default("")

  frequency String // WEEKLY | BIWEEKLY | MONTHLY
  // Nästa planerade leveransdatum. Flyttas fram när order genererats.
  nextDeliveryDate DateTime

  status String @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED

  // Personlig hanteringslänk (48 hex): kunden pausar, hoppar över, ändrar och
  // avslutar själv via /prenumeration/hantera/<token>. Skapas vid start,
  // fylls i lazily för äldre prenumerationer när ett mejl ska ut.
  manageToken String? @unique

  items  SubscriptionItem[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextDeliveryDate])
}

model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  weightKg       Int

  @@index([subscriptionId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String    @default("")
  passwordHash String // scrypt: salt:hash (hex)
  createdAt    DateTime  @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 av sessionstoken — själva token lagras aldrig
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  type      String // ORDER_CONFIRMATION | INVOICE | ...
  provider  String
  status    String // SENT | FAILED | SKIPPED
  error     String   @default("")
  orderId   String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String // CREATED | CONFIRMED | PAID | DELIVERED | CANCELLED | NOTE | EMAIL
  message   String
  actor     String   @default("system") // "system" | admin-e-post
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------- Folkets nästa småkaka ----------
// Återkommande omröstning: kunderna väljer vilket recept ur Svenskt
// konditorlexikon som blir nästa i sortimentet. Generisk modell – nya
// omgångar, kandidater, datum och vinnare skapas i admin utan kodändring.

model Poll {
  id            String   @id @default(cuid())
  slug          String   @unique
  /** Löpnummer i serien: "Folkets val #1". */
  sequence      Int      @default(1)
  title         String
  intro         String   @default("")
  /** Mänsklig etikett för slutdatumet, t.ex. "Luciadagen den 13 december". */
  deadlineLabel String   @default("")
  startsAt      DateTime
  endsAt        DateTime
  status        String   @default("DRAFT") // DRAFT | ACTIVE | CLOSED
  winnerCandidateId String?
  winnerAnnouncedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  candidates PollCandidate[]
  votes      PollVote[]
  signups    PollWinnerSignup[]
}

model PollCandidate {
  id              String   @id @default(cuid())
  pollId          String
  poll            Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  description     String   @default("")
  /** Kort notis om kakans plats i fikatraditionen. */
  tradition       String   @default("")
  imageRef        String   @default("")
  displayOrder    Int      @default(0)
  /** Sätts när vinnaren lanserats som produkt – ger "Folkets val"-proveniens. */
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  /** T.ex. sida/uppslag i Svenskt konditorlexikon. */
  sourceReference String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  votes PollVote[]

  @@unique([pollId, slug])
  @@index([pollId, displayOrder])
}

model PollVote {
  id          String        @id @default(cuid())
  pollId      String
  poll        Poll          @relation(fields: [pollId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   PollCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /** Anonym besökskaka – en röst per besökare och omgång (unikt villkor). */
  visitorId   String
  /** Saltat hash av IP – bara för att se misstänkt aktivitet i admin, aldrig rå IP. */
  ipHash      String        @default("")
  createdAt   DateTime      @default(now())

  @@unique([pollId, visitorId])
  @@index([pollId, candidateId])
  @@index([pollId, ipHash])
}

model PollWinnerSignup {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([pollId, email])
}

// ---------- Lager och leveransvecka ----------
// Fysiskt saldo lagras på Inventory. Reserverat och disponibelt räknas från
// öppna ordrar (ej avbrutna, ej plockade, ej levererade) – aldrig som eget
// fält som kan driva ifrån sanningen. Varje saldoändring får en rad i
// InventoryMovement (före/efter), så historiken kan reconcilieras.
//
// DeliveryWeek är ett operativt objekt per leveransDATUM (unikt), grupperat
// i UI per ISO-vecka. Ordrar dupliceras inte: veckan pekar på Order via
// deliveryDate. Efter cutoff lagras en immutable snapshotJson; ändringar
// efter låsning hamnar i lateChangesJson.

model Inventory {
  id            String   @id @default(cuid())
  productId     String   @unique
  product       Product  @relation(fields: [productId], references: [id])
  // Gram i frysen (Radiovägen 19). Paket räknas som antal × paketvikt.
  physicalGrams Int      @default(0)
  minGrams      Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  movements InventoryMovement[]
}

model InventoryMovement {
  id          String    @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  // INCOMING | OUTGOING | ADJUSTMENT | PICK | UNPICK
  kind        String
  gramsDelta  Int
  reason      String
  actor       String    @default("system")
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  beforeGrams Int
  afterGrams  Int
  createdAt   DateTime  @default(now())

  @@index([productId, createdAt])
  @@index([inventoryId, createdAt])
  @@index([orderId])
  @@index([kind])
}

/** Singleton: id är alltid "default". Cutoff och driftmejl styrs här, inte i env. */
model DeliveryOpsSettings {
  id            String   @id
  // ISO-veckodag då leveranslistan låses (3 = onsdag).
  cutoffWeekday Int      @default(3)
  cutoffHour    Int      @default(12)
  // Tom = ADMIN_NOTIFY_EMAIL. Kommaseparerat vid flera mottagare.
  opsEmail      String   @default("")
  updatedAt     DateTime @updatedAt
}

model DeliveryWeek {
  id           String   @id @default(cuid())
  deliveryDate DateTime @unique
  isoYear      Int
  isoWeek      Int
  // OPEN | LOCKING | LOCKED | PICKING | OUT_FOR_DELIVERY | COMPLETED
  status       String   @default("OPEN")
  lockedAt     DateTime?
  lockedBy     String   @default("")
  snapshotJson String   @default("")
  opsEmailSentAt DateTime?
  lateChangesJson String @default("[]")
  lastError    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isoYear, isoWeek])
  @@index([status])
}

